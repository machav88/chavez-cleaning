---
import '@/styles/global.css';
import '@/styles/fx.css';
import dmsans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import youngserif from '@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url';
import caveat from '@fontsource/caveat/files/caveat-latin-600-normal.woff2?url';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE, ENV } from '@/config/site';
import { defaultLocale, htmlLang, ogLocale, useStrings, type Locale } from '@/i18n';
import { abs, graph, businessNode, websiteNode, webPageNode, breadcrumbNode } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/services/deep-cleaning/". Defaults to current path. */
  path?: string;
  ogImage?: string; // absolute or root-relative
  ogType?: 'website' | 'article';
  breadcrumbs?: { name: string; href: string }[];
  schema?: unknown[];
  pageType?: string;
  noindex?: boolean;
  locale?: Locale;
  /** hreflang alternates — leave empty until a translated version exists. */
  alternates?: { hreflang: string; href: string }[];
  /** Root-relative image to preload as the LCP (e.g. a video poster). */
  preloadImage?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  breadcrumbs,
  schema = [],
  pageType,
  noindex = false,
  locale = defaultLocale,
  alternates = [],
  preloadImage,
} = Astro.props;

const t = useStrings(locale);
const canonical = abs(path);
const ogImageAbs = abs(ogImage);
const robots = !ENV.indexable || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const crumbs = breadcrumbs ? [{ name: t.nav.home, href: '/' }, ...breadcrumbs] : undefined;

const jsonLd = graph(
  businessNode(abs('/logo-chavez.png'), abs('/og-default.jpg')),
  websiteNode(),
  webPageNode({ url: canonical, name: title, description, type: pageType }),
  crumbs ? breadcrumbNode(crumbs) : null,
  ...schema,
);
---
<!doctype html>
<html lang={htmlLang[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preload" href={dmsans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={youngserif} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`
      @font-face{font-family:'DM Sans Variable';font-style:normal;font-display:swap;font-weight:100 1000;src:url(${dmsans}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Young Serif';font-style:normal;font-display:swap;font-weight:400;src:url(${youngserif}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Caveat';font-style:normal;font-display:optional;font-weight:600;src:url(${caveat}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    `} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f2a4a" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — house and office cleaning in Dallas, Texas`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {ENV.ga4Id && ENV.indexable && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ENV.ga4Id}`}></script>
        <script is:inline define:vars={{ id: ENV.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header />
    <main id="main" tabindex="-1">
      {crumbs && (
        <div class="wrap crumbs-wrap">
          <Breadcrumbs items={crumbs} />
        </div>
      )}
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '@/scripts/fx-loader';
      import '@/scripts/slider';
    </script>
  </body>
</html>

<style>
  .crumbs-wrap { padding-top: 1.25rem; }
  main:focus { outline: none; }
</style>
