---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import Swoosh from '@/components/Swoosh.astro';
import SectionBg from '@/components/SectionBg.astro';
import FastQuoted from '@/components/FastQuoted.astro';
import ServiceBento from '@/components/ServiceBento.astro';
import DallasMap from '@/components/DallasMap.astro';
import Faq from '@/components/Faq.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import TrustBadges from '@/components/TrustBadges.astro';
import GoogleReviews from '@/components/GoogleReviews.astro';
import { SITE } from '@/config/site';
import { services, serviceUrl } from '@/data/services';
import { areas } from '@/data/areas';
import { localPages, cityBySlug, localUrl } from '@/data/local';
import { useStrings } from '@/i18n';

const t = useStrings();
// Keyword targets: docs/KEYWORDS.md (home = house cleaning dallas tx + maid service + office cleaning)
const title = 'House Cleaning & Maid Service in Dallas, TX | Chavez';
const description =
  'Locally owned house cleaning, maid service and office cleaning in Uptown, East Dallas and the Park Cities. Call or text (972) 330-0164 for a free quote.';

const homeServices = services.filter((s) => s.track === 'home');
const bizServices = services.filter((s) => s.track === 'business');

const compare = [
  { s: 'house-cleaning', what: 'Kitchen, bathrooms, bedrooms, living areas and floors', when: 'Regular upkeep or a one-time refresh', how: 'One time, weekly, biweekly, every 3 weeks or monthly' },
  { s: 'deep-cleaning', what: 'Everything above + fixtures, trim, baseboards, vents, blinds and built-up grime', when: 'First visit, seasonal reset, before hosting', how: 'Once or twice a year' },
  { s: 'move-in-move-out-cleaning', what: 'Empty-home deep clean, inside cabinets, closets and appliances', when: 'Lease end, selling or moving in', how: 'Once, around your move date' },
  { s: 'office-cleaning', what: 'Workstations, restrooms, break room, reception and floors', when: 'Offices, studios and small commercial spaces', how: '1–3+ visits a week, after hours' },
  { s: 'post-construction-cleaning', what: 'Construction dust and residue from every surface', when: 'After building or remodeling', how: 'Rough clean + final clean' },
];

// Booking by text: illustrative example of how a request works (not a real client conversation).
const chat = [
  { from: 'you', text: 'Hi! Do you clean in Lower Greenville? 3 bed, 2 bath, about 1,600 sq ft.' },
  { from: 'us', text: 'Hi! Yes, we are 10 minutes away in East Dallas. Regular cleaning or deep cleaning?' },
  { from: 'you', text: 'Deep clean first, then every two weeks. Here’s a photo of the kitchen 📷' },
  { from: 'us', text: 'Perfect. Here is your free quote and the checklist. Does Thursday at 9am work?' },
];

const faqs = [
  { q: 'Which areas of Dallas do you serve?', a: 'We are based in East Dallas (75223) and clean homes and offices in Uptown, Lower Greenville, the M Streets, Swiss Avenue, Munger Place, Lakewood, White Rock Lake, Knox-Henderson, Oak Lawn, Deep Ellum, Downtown Dallas, Highland Park and University Park, plus nearby cities: Richardson, Plano, Allen, Carrollton, Addison, Garland, Irving and Mesquite.' },
  { q: 'How much does house cleaning cost in Dallas?', a: 'It depends on the number of bedrooms and bathrooms, the size and condition of the home, the type of cleaning and any add-ons. Call or text (972) 330-0164 with those details and we send a free quote before you book.' },
  { q: 'Do you clean offices?', a: 'Yes, offices are our main focus: dental offices, law firms, professional suites and studios in Uptown, Downtown, Deep Ellum, East Dallas and nearby cities, usually after hours, on a schedule built around your business.' },
  { q: 'How often can I schedule a cleaning?', a: 'One time, weekly, biweekly, every 3 weeks or monthly. Most clients start with a deep cleaning, then move to biweekly visits.' },
  { q: 'Do you do laundry?', a: 'No, we do not offer laundry service. We focus on cleaning your home or office.' },
];

const cityGroups = [...new Set(localPages.map((p) => p.city))].map((c) => ({
  name: cityBySlug(c).name,
  links: localPages.filter((p) => p.city === c).map((p) => ({ href: localUrl(p.service, p.city), label: services.find((s) => s.slug === p.service)!.name })),
}));
const quote = { text: 'Maria is dependable, professional, and friendly. She always arrives on time and does a great job.', name: 'Laila C' };
---
<BaseLayout title={title} description={description} path="/" >

  <!-- HERO — split: copy on deep navy (left), the real team photo large in an arch (right),
       Dallas at golden hour as a soft background. Mobile: the real photo is the banner on top, copy below. -->
  <section class="hero" id="top" aria-labelledby="hero-h">
    <div class="hero-bg" aria-hidden="true">
      <img class="hero-poster" src="/media/hero-dallas-poster.webp" alt="" width="1280" height="720" decoding="async" />
      <video class="hero-video" muted loop playsinline preload="none" data-autoplay>
        <source src="/media/hero-dallas.webm" type="video/webm" />
        <source src="/media/hero-dallas.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="wrap hero-grid">
      <div class="hero-photo">
        <Photo slug="team-living-room" alt="Chavez House Cleaning team member cleaning a living room with a navy sectional and hardwood floors" sizes="(min-width: 900px) 500px, 100vw" widths={[420, 640, 900, 1200]} quality={68} position="58% 50%" priority />
        <figure class="hero-review">
          <span class="hm-stars" aria-hidden="true">★★★★★</span>
          <blockquote><p>“{quote.text}”</p></blockquote>
          <figcaption>{quote.name} · Google review</figcaption>
        </figure>
        <Swoosh class="hero-swoosh" width={120} />
      </div>
      <div class="hero-copy">
        <p class="chip"><Icon name="pin" size={16} /> Uptown · East Dallas · Park Cities</p>
        <h1 id="hero-h">House cleaning in Dallas, <em>done like it’s our own home</em></h1>
        <p class="lead">Locally owned by Maria Chavez. Homes, apartments and offices: one time, weekly, biweekly, every 3 weeks or monthly.</p>
        <a class="call-card" href={SITE.phone.href} data-track="call_click">
          <span class="cc-ic"><Icon name="phone" size={22} /></span>
          <span><small>Call or text for a free quote</small><strong>{SITE.phone.display}</strong></span>
          <Icon name="arrow" size={20} />
        </a>
        <a class="btn btn--ghost hero-text" href={SITE.phone.sms} data-track="sms_click"><Icon name="message" />{t.cta.text}</a>
        <TrustBadges class="hero-trust" />
      </div>
      <div class="hero-quote" id="instant-quote">
        <p class="hq-title"><Icon name="sparkles" size={18} /> Get your instant quote</p>
        <FastQuoted eager />
      </div>
    </div>
  </section>

  <!-- Home or office -->
  <section class="section tracks-sec has-bg" aria-labelledby="tracks-h">
    <div class="wrap">
      <div class="tracks-head">
        <Swoosh width={90} />
        <h2 id="tracks-h">Cleaning your <em>home</em> or your <em>office</em>?</h2>
      </div>
      <div class="tracks">
        <article class="track" data-reveal>
          <span class="track-ic"><Icon name="home" size={40} draw /></span>
          <h3>Houses, apartments &amp; condos</h3>
          <p>From an Uptown studio to a historic home on Swiss Avenue, with the same checklist every visit.</p>
          <ul class="track-links">
            {homeServices.map((s) => <li><a href={serviceUrl(s.slug)}>{s.name}<Icon name="arrow" size={18} /></a></li>)}
          </ul>
        </article>
        <article class="track track--biz" data-reveal>
          <span class="track-ic"><Icon name="building" size={40} draw /></span>
          <h3>Offices, studios &amp; build-outs</h3>
          <p>After-hours cleaning for dental offices, law firms and small businesses in <a href="/services/office-cleaning/uptown/">Uptown</a>, <a href="/services/office-cleaning/downtown-dallas/">Downtown</a> and <a href="/services/office-cleaning/deep-ellum/">Deep Ellum</a>, on a schedule built around your hours.</p>
          <ul class="track-links">
            {bizServices.map((s) => <li><a href={serviceUrl(s.slug)}>{s.name}<Icon name="arrow" size={18} /></a></li>)}
          </ul>
          <p class="hand">Maria sets up every new office personally</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Services bento -->
  <section class="section cv has-bg" id="services" aria-labelledby="services-h">
    <SectionBg slug="bg-living-white" blur />
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><Icon name="sparkles" size={18} /> Services</p>
        <h2 id="services-h">Six services, <em>one written checklist</em> each</h2>
        <p class="sec-aside">You always know what is included before we arrive. Open a service to see its full checklist.</p>
      </div>
      <ServiceBento />
    </div>
  </section>

  <!-- Fixed window: offices after hours -->
  <section class="window on-dark" aria-labelledby="window-h">
    <div class="window-media" aria-hidden="true">
      <img src="/media/office-window-poster.webp" alt="" width="1280" height="720" loading="lazy" decoding="async" />
      <video muted loop playsinline preload="none" data-autoplay>
        <source src="/media/office-window.webm" type="video/webm" />
        <source src="/media/office-window.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="wrap window-inner">
      <p class="kicker"><Icon name="clock" size={18} /> Office cleaning</p>
      <h2 id="window-h">We clean <em>after you clock out</em>.</h2>
      <p>Your team walks into a clean office every morning: desks, restrooms, break room and floors, on a custom checklist.</p>
      <a class="btn btn--mint" href="/services/office-cleaning/">See office cleaning<Icon name="arrow" /></a>
      <button class="video-toggle" type="button" data-video-toggle hidden data-paused="true">
        <span class="when-playing">Pause video</span><span class="when-paused">Play video</span>
      </button>
    </div>
  </section>

  <!-- Booking by text -->
  <section class="section cv book has-bg" id="process" aria-labelledby="how-h">
    <div class="wrap book-grid">
      <div>
        <p class="kicker"><Icon name="message" size={18} /> How booking works</p>
        <h2 id="how-h">Booking takes <em>one text message</em></h2>
        <ol class="book-steps">
          <li><strong>Text or call us</strong> with your neighborhood, size and type of cleaning. Photos help.</li>
          <li><strong>Get a free quote</strong> and the checklist, and pick a day.</li>
          <li><strong>Walk into a clean space.</strong> Tell us how it went; we keep improving.</li>
        </ol>
        <a class="btn btn--mint" href={SITE.phone.sms} data-track="sms_click"><Icon name="message" />Text {SITE.phone.display}</a>
      </div>
      <figure class="phone-mock" aria-label="Example of a booking conversation by text">
        <div class="pm-top"><span class="pm-av">C</span><span><strong>Chavez House Cleaning</strong><small>Text message</small></span></div>
        <ol class="pm-chat">
          {chat.map((m, i) => <li class:list={['bub', `bub--${m.from}`]} style={`--i:${i}`}>{m.text}</li>)}
        </ol>
        <figcaption>Example conversation</figcaption>
      </figure>
    </div>
  </section>

  <!-- Which cleaning do I need? (AEO comparison table) -->
  <section class="section cv has-bg" id="compare" aria-labelledby="compare-h">
    <SectionBg slug="space-kitchen-windows" />
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><Icon name="clipboard" size={18} /> Quick guide</p>
        <h2 id="compare-h">Which cleaning do I need?</h2>
      </div>
      <p class="answer">Choose <strong>house cleaning</strong> for regular upkeep, <strong>deep cleaning</strong> for a first visit or a reset, <strong>move-in/move-out</strong> for an empty home, <strong>office cleaning</strong> for a workspace and <strong>post-construction</strong> after a remodel.</p>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Comparison of cleaning services">
        <table class="cmp">
          <thead><tr><th scope="col">Service</th><th scope="col">What it covers</th><th scope="col">Best for</th><th scope="col">How often</th></tr></thead>
          <tbody>
            {compare.map((c) => {
              const s = services.find((x) => x.slug === c.s)!;
              return <tr><th scope="row"><a href={serviceUrl(s.slug)}>{s.name}</a></th><td>{c.what}</td><td>{c.when}</td><td>{c.how}</td></tr>;
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Reviews wall -->
  <GoogleReviews heading="What Dallas clients say on" />

  <!-- Owner story -->
  <section class="section cv owner has-bg" aria-labelledby="owner-h">
    <div class="wrap owner-grid">
      <div class="owner-media" data-reveal>
        <Photo slug="maria-sunroom" alt="Chavez House Cleaning team member in a sunroom with tall windows after finishing a cleaning" sizes="(min-width: 900px) 420px, 90vw" widths={[420, 700, 840]} aspect="4 / 5" position="30% 50%" class="photo-in" />
        <Swoosh class="owner-swoosh" width={140} />
        <p class="owner-note hand">10+ years cleaning Dallas homes</p>
      </div>
      <div>
        <p class="kicker"><Icon name="sparkles" size={18} /> Owner-led</p>
        <h2 id="owner-h">A local company with <em>the owner on every job</em></h2>
        <p>Maria Chavez has been cleaning homes for more than 10 years and started Chavez House Cleaning to do it her way: show up on time, communicate clearly and treat every home like her own.</p>
        <p>You talk to Maria, not a call center. Our team follows a written checklist, and if something is not right, we come back and fix it.</p>
        <ul class="promises">
          <li><Icon name="home" size={26} draw /><span>We treat your home like our own</span></li>
          <li><Icon name="clock" size={26} draw /><span>We keep our appointments</span></li>
          <li><Icon name="key" size={26} draw /><span>Keys and codes handled with care</span></li>
        </ul>
        <a class="btn btn--ghost" href="/about/">Meet Chavez House Cleaning<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Map of service areas -->
  <section class="section cv areas-sec has-bg" id="areas" aria-labelledby="areas-h">
    <SectionBg slug="dallas-bridge" position="50% 40%" />
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><Icon name="pin" size={18} /> Service areas</p>
        <h2 id="areas-h">Based in East Dallas, <em>minutes from you</em></h2>
        <p class="sec-aside">Our team is based in 75223, so Uptown, Lower Greenville and Swiss Avenue are a short drive. That is how we stay on time.</p>
      </div>
      <div class="map-grid">
        <DallasMap />
        <div class="areas-list">
          <h3>Core neighborhoods</h3>
          <ul class="area-chips" tabindex="0" aria-label="Core neighborhoods">{areas.filter((a) => a.hub).map((a) => <li>{a.name}</li>)}</ul>
          <h3>Nearby cities we serve</h3>
          <ul class="area-chips area-chips--soft" tabindex="0" aria-label="Nearby cities">{areas.filter((a) => !a.hub).map((a) => <li>{a.name}</li>)}</ul>
          <a class="btn btn--ghost" href="/service-areas/">All service areas<Icon name="arrow" /></a>
        </div>
      </div>
      <nav class="hoods" aria-label="Cleaning services by neighborhood">
        <p class="lc-h">Cleaning services by neighborhood</p>
        <ul class="hood-row" tabindex="0" aria-label="Neighborhoods and their cleaning services">
          {cityGroups.map((g) => (
            <li class="hood">
              <p class="hood-name"><Icon name="pin" size={16} /> {g.name}</p>
              <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}<Icon name="arrow" size={14} /></a></li>)}</ul>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <Faq items={faqs} />

  <!-- Closing postcard -->
  <section class="section cv closing has-bg" id="estimate" aria-labelledby="estimate-h">
    <SectionBg slug="living-room-hardwood" tone="dark" />
    <div class="wrap">
      <div class="closing-grid">
        <div class="closing-quote">
          <p class="hq-title"><Icon name="sparkles" size={18} /> Get your instant quote</p>
          <FastQuoted primary={false} />
        </div>
        <div class="postcard-cta">
          <div class="pc-copy">
            <Swoosh width={80} />
            <h2 id="estimate-h">Ready for a <em>cleaner home</em> or office?</h2>
            <p>Prefer to talk? Call or text with your neighborhood and a few details. Photos are welcome.</p>
            <p class="hand">— Maria &amp; the Chavez team</p>
          </div>
          <ContactChannels id="quote" tone="light" />
          <TrustBadges tone="light" class="closing-trust" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: clip; background: var(--ink); color: #e6eef8; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-poster, .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(15 42 74 / 0.92) 0%, rgb(15 42 74 / 0.75) 38%, rgb(15 42 74 / 0.15) 65%, rgb(15 42 74 / 0) 100%), linear-gradient(to top, rgb(15 42 74 / 0.55), transparent 35%); }
  .hero-grid { display: grid; gap: 3rem; align-items: center; padding-block: clamp(3rem, 2rem + 4vw, 5.5rem); min-height: min(calc(100svh - var(--header-h)), 800px); }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(420px, 540px); gap: 3.5rem; align-items: start; } .hero-photo { display: none; } .hero-copy { padding-top: 2rem; } }
  .hero-quote { width: 100%; }
  .hq-title { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.6rem; font: 400 1.35rem/1.2 var(--font-display); color: #fff; }
  .hq-title :global(svg) { color: var(--sun); }
  @media (max-width: 899px) { .hq-title { color: var(--ink); } .hq-title :global(svg) { color: var(--mint-ink); } }
  .hero-photo { position: relative; width: 100%; max-width: 360px; justify-self: end; align-self: end; }
  .hero-photo :global(.photo) { aspect-ratio: 4 / 5; border-radius: 200px 200px 28px 28px; box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.7); outline: 6px solid rgb(255 255 255 / 0.85); outline-offset: 0; }
  :global(.hero-swoosh) { position: absolute; right: -2.5rem; top: -0.5rem; }
  .hero-review { position: absolute; left: -2.5rem; bottom: 2rem; max-width: 280px; margin: 0; padding: 1rem 1.15rem; background: #fff; color: var(--ink); border-radius: 20px; box-shadow: 0 30px 50px -24px rgb(0 0 0 / 0.6); }
  .hm-stars { color: #b45309; letter-spacing: 0.1em; font-size: 0.95rem; }
  .hero-review blockquote { margin: 0.3rem 0; }
  .hero-review p { margin: 0; font: 400 0.98rem/1.4 var(--font-display); color: var(--ink); }
  .hero-review figcaption { font-size: 0.78rem; color: var(--muted); }
  .chip { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; border-radius: 999px; background: rgb(255 255 255 / 0.1); border: 1px solid rgb(255 255 255 / 0.22); font-size: 0.85rem; font-weight: 600; color: #fff; margin-bottom: 1.25rem; }
  .chip :global(svg) { color: var(--sun); }
  .hero h1 { color: #fff; font-size: clamp(2.4rem, 1.5rem + 3.4vw, 4.4rem); line-height: 1.04; letter-spacing: -0.02em; max-width: 14ch; }
  .hero h1 em { display: block; color: var(--sky); background: none; padding: 0; }
  .hero .lead { color: #dce8f5; max-width: 46ch; margin-bottom: 1.75rem; }
  .call-card { display: inline-flex; align-items: center; gap: 0.9rem; padding: 0.7rem 1.1rem 0.7rem 0.7rem; border-radius: 22px; background: var(--sky); color: var(--ink); text-decoration: none; box-shadow: 0 20px 40px -20px rgb(75 176 251 / 0.8); transition: transform 0.25s ease, background-color 0.25s ease; }
  .call-card:hover { transform: translateY(-2px); background: #7cc6ff; }
  .cc-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 16px; background: var(--ink); color: var(--sky); }
  .call-card small { display: block; font-size: 0.8rem; font-weight: 600; }
  .call-card strong { font: 400 1.5rem/1.1 var(--font-display); }
  .hero-text { margin-top: 0.8rem; margin-left: 0.5rem; --fg: #fff; border-color: rgb(255 255 255 / 0.6); }
  .hero-text:hover { background: #fff; color: var(--ink); }
  :global(.hero-trust) { margin-top: 1.5rem; }
  .hero-review { left: auto; right: 2rem; bottom: -1.5rem; max-width: 300px; }
  @media (max-width: 1199px) and (min-width: 900px) { .hero-review { display: none; } }

  /* Mobile: real photo as the banner on top, short copy below (Helice rule) */
  @media (max-width: 899px) {
    .hero { background: var(--paper); color: var(--ink-soft); }
    .hero-bg { display: none; }
    .hero-grid { padding: 0 0 2.5rem; gap: 0; min-height: 0; width: 100%; }
    .hero-photo { max-width: none; }
    .hero-photo :global(.photo) { aspect-ratio: 4 / 3.3; border-radius: 0 0 110px 0; outline: none; box-shadow: none; }
    :global(.hero-swoosh) { display: none; }
    .hero-review { left: auto; right: var(--gutter); bottom: -2.2rem; max-width: 74%; padding: 0.7rem 0.9rem; }
    .hero-review p { font-size: 0.85rem; }
    .hero-copy { padding: 3.25rem var(--gutter) 0; }
    .hero-quote { margin: 2rem 0 0; width: 100%; }
    .hq-title { margin-inline: var(--gutter); }
    .chip { background: var(--mint-wash); border-color: var(--line); color: var(--ink); }
    .chip :global(svg) { color: var(--mint-ink); }
    .hero h1 { color: var(--ink); font-size: clamp(2.1rem, 1.6rem + 3vw, 2.8rem); }
    .hero h1 em { color: var(--mint-ink); }
    .hero .lead { color: var(--ink-soft); font-size: 1rem; }
    .call-card { width: 100%; }
    .call-card > :global(svg:last-child) { margin-left: auto; }
    .hero-text { display: none; }
    .hero :global(.trust--dark) { color: var(--muted); }
    .hero :global(.trust--dark strong) { color: var(--mint-ink); }
  }

  /* Skip rendering work for below-the-fold sections until they approach the viewport */
  .cv { content-visibility: auto; contain-intrinsic-size: auto 900px; }

  /* ---------- Section heads ---------- */
  .kicker { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mint-ink); margin-bottom: 0.8rem; }
  .on-dark .kicker { color: var(--sun); }
  .sec-head { display: grid; gap: 0.25rem 4rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  @media (min-width: 960px) { .sec-head { grid-template-columns: 1.2fr 0.8fr; align-items: end; } .sec-head .kicker { grid-column: 1 / -1; } }
  .sec-head h2 { margin: 0; font-size: clamp(2rem, 1.4rem + 2.4vw, 3.3rem); }
  .sec-aside { color: var(--muted); margin: 0; }

  /* ---------- Tracks ---------- */
  .has-bg { position: relative; isolation: isolate; }
  .tracks-sec { background: var(--paper); }
  .tracks-head { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .tracks-head h2 { margin: 0; text-align: center; font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem); }
  .tracks { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .tracks { grid-template-columns: 1fr 1fr; } }
