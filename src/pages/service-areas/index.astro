---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AreasBlock from '@/components/AreasBlock.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';
import PageHero from '@/components/PageHero.astro';
import Backdrop from '@/components/fx/Backdrop.astro';
import { areas } from '@/data/areas';

const title = 'Service Areas: Uptown, East Dallas & Park Cities | Chavez';
const description =
  'Where Chavez House Cleaning works: Uptown, Lower Greenville, M Streets, Swiss Avenue, Lakewood, Deep Ellum, Downtown Dallas, Highland Park and University Park.';
const counts = {
  neighborhoods: areas.filter((a) => a.kind === 'Dallas neighborhood').length,
  cities: areas.filter((a) => a.hub === 'park-cities').length,
};
const hubs = [
  { href: '/service-areas/dallas/', photo: 'living-room-hardwood', pos: '50% 55%', title: 'Uptown & East Dallas', list: 'Uptown, Lower Greenville, M Streets, Swiss Avenue, Munger Place, Lakewood, Knox-Henderson, Oak Lawn, Deep Ellum, Downtown', go: 'Cleaning in Uptown & East Dallas' },
  { href: '/service-areas/park-cities/', photo: 'sunroom-sofa-rug', pos: '50% 60%', title: 'Highland Park & University Park', list: 'The Park Cities, surrounded by Dallas', go: 'Cleaning in the Park Cities' },
] as const;
---
<BaseLayout title={title} description={description} path="/service-areas/" breadcrumbs={[{ name: 'Service Areas', href: '/service-areas/' }]}>
  <PageHero
    eyebrow="Service areas"
    title="Where we clean in Dallas"
    lead={`Chavez House Cleaning is a mobile team based in East Dallas (75223): we come to your home or office. We regularly clean in ${counts.neighborhoods} Dallas neighborhoods and the ${counts.cities} Park Cities.`}
    photo="open-living-kitchen"
    photoAlt="Bright open living room and kitchen in a Dallas home after cleaning"
    position="50% 60%"
  />

  <section class="section section--white fx-section grain" aria-labelledby="hubs-h">
    <Backdrop variant="map" />
    <div class="wrap">
      <p class="chapter-tag"><span class="n">01</span>Local pages</p>
      <h2 id="hubs-h" class="fx-title big-h">Two areas, <em>one careful team</em></h2>
      <div class="hubs">
        {hubs.map((h) => (
          <a class="hub" href={h.href} data-reveal>
            <Photo slug={h.photo} alt="" sizes="(min-width: 900px) 580px, 92vw" widths={[480, 720, 1000]} position={h.pos} />
            <span class="hub-veil" aria-hidden="true"></span>
            <span class="hub-body">
              <span class="hub-title">{h.title}</span>
              <span class="hub-list">{h.list}</span>
              <span class="hub-go">{h.go}<Icon name="arrow" size={18} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section fx-section grain" aria-labelledby="list-h">
    <Backdrop variant="mesh" />
    <div class="wrap">
      <div class="head-split">
        <div>
          <p class="chapter-tag"><span class="n">02</span>Full list</p>
          <h2 id="list-h" class="fx-title big-h">Every area we serve</h2>
        </div>
        <p class="head-aside">Uptown, Lower Greenville, Swiss Avenue and the other neighborhoods are part of the City of Dallas. Highland Park and University Park are separate towns surrounded by Dallas. Nearby cities are served on request.</p>
      </div>
      <AreasBlock headingLevel="h3" />
      <p class="note outside"><Icon name="info" size={18} /> Near one of these areas but not listed? Contact us — we will tell you honestly whether we can reach you.</p>
    </div>
  </section>

  <CtaBand heading="Check availability in your area" text="Tell us your city or neighborhood and the type of cleaning you need." />
</BaseLayout>

<style>
  .big-h { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem); letter-spacing: -0.03em; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .hubs { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .hub {
    position: relative; display: block; min-height: clamp(360px, 46vw, 520px); border-radius: var(--radius-lg); overflow: hidden;
    text-decoration: none; color: #fff; isolation: isolate;
    box-shadow: 0 2px 4px rgb(15 42 74 / 0.08), 0 36px 60px -34px rgb(15 42 74 / 0.6);
  }
  .hub :global(.photo) { position: absolute; inset: 0; z-index: -2; border-radius: 0; }
  .hub :global(.photo picture), .hub :global(.photo img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 0.9s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .hub:hover :global(.photo img) { scale: 1.06; }
  .hub-veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(15 42 74 / 0.92) 15%, rgb(15 42 74 / 0.35) 60%, transparent); }
  .hub-body { position: absolute; inset: auto 0 0 0; display: grid; gap: 0.5rem; padding: clamp(1.4rem, 1rem + 1.5vw, 2.2rem); }
  .hub-title { font: 400 clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem)/1.05 var(--font-display); letter-spacing: -0.03em; }
  .hub-list { color: #dce8f5; font-size: 0.97rem; }
  .hub-go {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.6rem;
    padding: 0.6rem 1.1rem; border-radius: 999px; background: var(--mint); color: var(--ink); font-weight: 650;
  }
  .hub-go :global(svg) { transition: transform 0.25s ease; }
  .hub:hover .hub-go :global(svg) { transform: translateX(4px); }
  .hub:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }

  .head-split { display: grid; gap: 1rem 4rem; align-items: end; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  @media (min-width: 960px) { .head-split { grid-template-columns: 1fr 1fr; } }
  .head-split .big-h { margin-bottom: 0; }
  .head-aside { color: var(--muted); margin: 0; }
  .outside { display: flex; gap: 0.5rem; align-items: center; margin-top: 1.5rem; }
</style>
