---
import type { Faq } from '@/data/services';
import { faqNode } from '@/lib/schema';
import SectionBg from './SectionBg.astro';
import type { PhotoSlug } from '@/data/photos';
interface Props { items: Faq[]; heading?: string; id?: string; class?: string; chapter?: string; bg?: PhotoSlug }
const { items, heading = 'Frequently asked questions', id = 'faq', class: cls, chapter, bg } = Astro.props;
---
<section class={['section faq', cls].filter(Boolean).join(' ')} id={id} aria-labelledby={`${id}-h`}>
  <slot name="backdrop" />
  {bg && <SectionBg slug={bg} blur />}
  <div class="wrap grid-faq">
    <div>
      {chapter ? <p class="chapter-tag"><span class="n">{chapter}</span>FAQ</p> : <p class="eyebrow">FAQ</p>}
      <h2 id={`${id}-h`} class={chapter ? 'fx-title' : undefined}>{heading}</h2>
      <p class="muted">Still have a question? Call or text us — we are happy to help.</p>
      <p class="hand faq-hand">Real answers from Maria’s team</p>
    </div>
    <div class="list">
      {items.map((f) => (
        <details data-reveal>
          <summary><span class="qmark" aria-hidden="true">?</span><h3>{f.q}</h3><span class="plus" aria-hidden="true"></span></summary>
          <div class="a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqNode(items))} />
</section>
<style>
  .faq { position: relative; isolation: isolate; }
  .grid-faq { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .grid-faq { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }
  .muted { color: var(--muted); }
  .list { display: grid; gap: 0.75rem; }
  details { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  details[open] { border-color: #c9c1b0; box-shadow: var(--shadow); }
  details { transition: border-color 0.2s ease, box-shadow 0.25s ease, transform 0.25s ease; }
  details:not([open]):hover { border-color: #c9c1b0; transform: translateY(-1px); }
  summary:hover h3 { color: var(--blue); }
  summary h3 { transition: color 0.2s ease; }
  summary { list-style: none; cursor: pointer; display: flex; gap: 1rem; justify-content: space-between; align-items: center; padding: 1.1rem 1.25rem; border-radius: var(--radius); }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.07rem; font-family: var(--font-body); font-weight: 650; letter-spacing: 0; }
  .plus { flex: none; position: relative; width: 28px; height: 28px; border-radius: 50%; background: var(--mint-wash); }
  .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; background: var(--mint-ink); transform: translate(-50%, -50%); transition: transform 0.2s ease; }
  .plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .a { padding: 0 1.25rem 1.1rem; }
  .a p { margin: 0; }
  details { border-radius: 22px; border-style: dashed; }
  details[open] { border-style: solid; border-color: var(--blue); }
  summary { justify-content: flex-start; }
  summary h3 { flex: 1; }
  .qmark { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--sun); color: var(--ink); font: 400 1.2rem/1 var(--font-display); }
  details[open] .qmark { background: var(--blue); color: #fff; }
  .a { padding-left: calc(1.25rem + 38px + 1rem); }
  .faq-hand { margin-top: 1rem; }
</style>
