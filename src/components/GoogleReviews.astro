---
/**
 * Google reviews section in Google's official brand colors
 * (#4285F4 blue, #EA4335 red, #FBBC04 yellow, #34A853 green).
 * Cards sit in a masonry wall (CSS columns); the first review is the lead quote.
 */
import { SITE } from '@/config/site';
import { googleReviews } from '@/data/reviews';
import SectionBg from './SectionBg.astro';
import type { PhotoSlug } from '@/data/photos';
interface Props { chapter?: string; heading?: string; bg?: PhotoSlug }
const { chapter, heading = 'What our clients say on', bg } = Astro.props;
const g = SITE.googleRating;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const avatarColors = ['#4285F4', '#EA4335', '#FBBC04', '#34A853'];
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z';
---
<section class="section gr fx-section grain" id="reviews" aria-labelledby="reviews-h" style="position:relative;isolation:isolate">
  {bg && <SectionBg slug={bg} blur />}
  <div class="wrap">
    <div class="gr-head">
      <div>
        {chapter ? <p class="chapter-tag"><span class="n">{chapter}</span>Reviews</p> : <p class="eyebrow">Reviews</p>}
        <h2 id="reviews-h" class="fx-title">{heading} <span class="g-word" role="img" aria-label="Google"><span aria-hidden="true"><b style="color:#4285F4">G</b><b style="color:#EA4335">o</b><b style="color:#FBBC04">o</b><b style="color:#4285F4">g</b><b style="color:#34A853">l</b><b style="color:#EA4335">e</b></span></span></h2>
      </div>
      <div class="gr-score">
        <svg class="g-logo" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.2C12.4 13.7 17.7 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.4-4.6 7l7.4 5.8c4.3-4 6.9-9.9 6.9-17.3z"/>
          <path fill="#FBBC04" d="M10.5 28.6c-.5-1.4-.8-2.9-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C.9 16.5 0 20.1 0 24s.9 7.5 2.6 10.8l7.9-6.2z"/>
          <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.8c-2.1 1.4-4.8 2.3-8.5 2.3-6.3 0-11.6-4.2-13.5-10l-7.9 6.2C6.6 42.6 14.6 48 24 48z"/>
        </svg>
        <div>
          {g ? (<>
          <p class="gr-num"><strong>{g.value}</strong><span class="gr-stars" aria-hidden="true">{Array.from({ length: 5 }, () => <svg viewBox="0 0 24 24" width="20" height="20"><path d={star} /></svg>)}</span></p>
          <p class="gr-meta">Based on {g.count} Google reviews</p>
          </>) : (<>
          <p class="gr-num"><span class="gr-stars" aria-hidden="true">{Array.from({ length: 5 }, () => <svg viewBox="0 0 24 24" width="20" height="20"><path d={star} /></svg>)}</span></p>
          <p class="gr-meta">Real 5-star reviews from Dallas clients</p>
          </>)}
        </div>
      </div>
    </div>

    <ul class="wall" role="list" tabindex="0" aria-label="Google reviews from Dallas clients">
      {googleReviews.map((r, i) => (
        <li class:list={['gr-card', i === 0 && 'gr-card--lead']} data-reveal>
          <figure>
            <div class="gr-top">
              <span class="gr-av" style={`background:${avatarColors[i % 4]}`} aria-hidden="true">{r.name.charAt(0)}</span>
              <div>
                <p class="gr-name">{r.name}</p>
                <p class="gr-sub">{r.service ? `${r.service} · ` : ''}<time datetime={r.date}>{fmt(r.date)}</time></p>
              </div>
              <svg class="gr-g" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.2C12.4 13.7 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.4-4.6 7l7.4 5.8c4.3-4 6.9-9.9 6.9-17.3z"/><path fill="#FBBC04" d="M10.5 28.6c-.5-1.4-.8-2.9-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C.9 16.5 0 20.1 0 24s.9 7.5 2.6 10.8l7.9-6.2z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.8c-2.1 1.4-4.8 2.3-8.5 2.3-6.3 0-11.6-4.2-13.5-10l-7.9 6.2C6.6 42.6 14.6 48 24 48z"/></svg>
            </div>
            <p class="gr-stars gr-stars--sm" role="img" aria-label="5 out of 5 stars">{Array.from({ length: 5 }, () => <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={star} /></svg>)}</p>
            <blockquote><p>“{r.text}”</p></blockquote>
            <figcaption class="visually-hidden">Review by {r.name} on Google</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="btn-row gr-actions">
      {SITE.listings.google && <a class="btn btn--google" href={SITE.listings.google} rel="noopener" target="_blank">Read our reviews on Google<span class="visually-hidden"> (opens in a new tab)</span></a>}
      {SITE.listings.googleReview && <a class="btn btn--ghost" href={SITE.listings.googleReview} rel="noopener" target="_blank">Write a review<span class="visually-hidden"> (opens in a new tab)</span></a>}
    </div>
  </div>
</section>

<style>
  .gr { background: #f8f9fa; }
  .gr-head { display: grid; gap: 1.5rem; align-items: end; margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); }
  @media (min-width: 900px) { .gr-head { grid-template-columns: 1fr auto; gap: 3rem; } }
  .gr-head h2 { margin: 0; max-width: 20ch; }
  /* Google wordmark: official letter colors (brand logotype) */
  .g-word { white-space: nowrap; }
  .g-word b { font-weight: inherit; }
  .gr-score { display: flex; gap: 1rem; align-items: center; background: #fff; border: 1px solid #dadce0; border-radius: 18px; padding: 1rem 1.25rem; box-shadow: 0 1px 2px rgb(60 64 67 / 0.15), 0 2px 6px rgb(60 64 67 / 0.08); }
  .gr-num { margin: 0; display: flex; align-items: center; gap: 0.6rem; }
  .gr-num strong { font: 400 2.2rem/1 var(--font-display); color: #202124; }
  .gr-stars { display: inline-flex; gap: 2px; fill: #FBBC04; margin: 0; }
  .gr-meta { margin: 0.25rem 0 0; color: #5f6368; font-size: 0.92rem; }

  .gr-track { list-style: none; margin: 0; padding: 0.25rem 0.25rem 0.5rem; display: grid; grid-auto-flow: column; grid-auto-columns: min(86%, 380px); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .gr-track::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) { .gr-track { grid-auto-columns: calc((100% - 2rem) / 3); } }
  .gr-track:focus-visible { outline: 3px solid #1a73e8; outline-offset: 4px; border-radius: 18px; }
  .gr-card { scroll-snap-align: start; }
  .gr-card figure { margin: 0; height: 100%; display: flex; flex-direction: column; gap: 0.75rem; background: #fff; border: 1px solid #dadce0; border-radius: 18px; padding: 1.35rem 1.35rem 1.5rem; box-shadow: 0 1px 2px rgb(60 64 67 / 0.12); transition: box-shadow 0.3s ease, translate 0.3s ease; }
  .gr-card figure:hover { box-shadow: 0 1px 3px rgb(60 64 67 / 0.2), 0 12px 28px -12px rgb(60 64 67 / 0.35); translate: 0 -3px; }
  .gr-top { display: flex; align-items: center; gap: 0.75rem; }
  .gr-top > div { flex: 1; min-width: 0; }
  .gr-av { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: #fff; font-weight: 700; font-size: 1.05rem; flex: none; }
  .gr-name { margin: 0; font-weight: 700; color: #202124; }
  .gr-sub { margin: 0; font-size: 0.85rem; color: #5f6368; }
  .gr-g { flex: none; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; color: #3c4043; line-height: 1.6; }

  .slider-ui { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.25rem; }
  .gr-actions { margin-top: 2rem; justify-content: center; gap: 1rem; }
  :global(.btn--google) { background: #1a73e8; color: #fff; border-color: #1a73e8; }
  :global(.btn--google:hover) { background: #1765cc; border-color: #1765cc; color: #fff; }
  .wall { list-style: none; margin: 0; padding: 0; columns: 3 300px; column-gap: 16px; }
  .wall .gr-card { break-inside: avoid; margin: 0 0 16px; width: auto; }
  .gr-card--lead figure { background: #1A73E8; border-color: transparent; }
  .gr-card--lead blockquote p { color: #fff; font: 400 1.12rem/1.5 var(--font-display); }
  .gr-card--lead .gr-name { color: #fff; }
  .gr-card--lead .gr-sub { color: #e3edff; }
  .gr-card--lead .gr-g { background: #fff; border-radius: 50%; padding: 2px; }
  @media (max-width: 699px) {
    .wall { columns: auto; display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(var(--gutter) * -1); padding: 0 var(--gutter) 0.75rem; }
    .wall .gr-card { flex: 0 0 84%; margin: 0; scroll-snap-align: start; }
    .wall .gr-card figure { height: 100%; }
    .wall::after { content: ''; flex: 0 0 1px; }
  }
</style>
