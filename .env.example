# Copy to .env for local overrides. Never commit real secrets.

# Canonical origin used for canonicals, sitemap and Open Graph URLs.
SITE_URL=https://chavezhousecleaning.com

# "true" only for the real production build (Cloudflare build variable).
# Anything else adds <meta name="robots" content="noindex"> and a Disallow-all robots.txt.
SITE_INDEXABLE=false

# Quote form transport: demo | endpoint
#  demo     -> validates locally, sends nothing, tells the visitor so (default)
#  endpoint -> POSTs JSON to PUBLIC_FORM_ENDPOINT (Cloudflare Worker, Formspree...)
PUBLIC_FORM_MODE=demo
PUBLIC_FORM_ENDPOINT=

# Optional analytics (GA4 measurement ID, e.g. G-XXXXXXX). Empty = no tag.
PUBLIC_GA4_ID=
